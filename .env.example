# === Gratis: Groq (chat) + embedding lokal ===
# Ambil key: https://console.groq.com/keys
GROQ_API_KEY=gsk_...
AI_CHAT_PROVIDER=groq
OPENAI_CHAT_MODEL=llama-3.1-8b-instant
EMBED_PROVIDER=local

# Demo read-only (otomatis true di Vercel). Set true untuk uji lokal.
# LUMEN_DEMO_MODE=true

# === Opsional: Gemini / OpenAI ===
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_CHAT_MODEL=gemini-flash-latest
# OPENAI_EMBED_MODEL=gemini-embedding-001
# EMBED_PROVIDER=api
