# === Gratis: Groq (chat) + embedding lokal ===
GROQ_API_KEY=gsk_...
AI_CHAT_PROVIDER=groq
OPENAI_CHAT_MODEL=llama-3.1-8b-instant
EMBED_PROVIDER=local

# === Supabase (Postgres) — gratis free tier ===
# 1) Buat project di https://supabase.com
# 2) SQL Editor → jalankan supabase/schema.sql
# 3) Settings → API → copy URL + service_role key
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Demo read-only paksa (abaikan Supabase). Default: auto.
# LUMEN_DEMO_MODE=true

# === Opsional: Gemini / OpenAI ===
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_CHAT_MODEL=gemini-flash-latest
# OPENAI_EMBED_MODEL=gemini-embedding-001
# EMBED_PROVIDER=api
