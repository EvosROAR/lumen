# === Gratis: Groq (chat) + embedding lokal ===
GROQ_API_KEY=gsk_...
AI_CHAT_PROVIDER=groq
OPENAI_CHAT_MODEL=llama-3.1-8b-instant
EMBED_PROVIDER=local

# === Supabase Auth + Postgres (wajib untuk login lokal) ===
# 1) Buat project di https://supabase.com
# 2) SQL Editor → jalankan supabase/schema-auth.sql (atau schema.sql untuk project baru)
# 3) Settings → API → copy URL, anon key, service_role key
# 4) Authentication → Providers → Email ON; Google ON (opsional) + redirect URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Seed admin (opsional): npm run seed:supabase
# SEED_USER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Demo read-only paksa. Default: off untuk local auth.
# LUMEN_DEMO_MODE=true

# === Opsional: Gemini / OpenAI ===
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_CHAT_MODEL=gemini-flash-latest
# OPENAI_EMBED_MODEL=gemini-embedding-001
# EMBED_PROVIDER=api
